.DS_Store
node_modules
.idea
package-lock.json
.firecrawl/

# Throwaway generator and check scripts. They are meant to be written into the
# project root and deleted in the same command; one survived a failed run and
# shipped, so the pattern is enforced here too.
_*.py
_*.mjs

# Wrangler build cache.
worker/.wrangler/

# The repo root IS the Pages deploy directory and there is no build step, so
# anything tracked here is a public URL on jldatrum.com. Working notes and copy
# drafts stay local. NEW-CHAT-PROMPT.md was served at 200 for three commits.
NEW-CHAT-PROMPT.md
HOME-COPY-BRIEF.md
DATRUM-copy-EN.txt
DATRUM-copy-ES.txt
DATRUM-current-copy.txt
datrum website copy.txt

# The CRM port. _crm-source/ is reference code that is never deployed, and the
# root IS the Pages deploy directory, so an untracked copy here is one
# `git add -A` away from being served at jldatrum.com/_crm-source/. The
# existing `_*.py` / `_*.mjs` rules do not cover directories.
_crm-source/
*.zip
.dev.vars
