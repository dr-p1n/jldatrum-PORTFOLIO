# Retired URLs -> their successor. 301, so any inbound link or search result
# that still points at a deleted page carries its equity to the replacement
# instead of landing on a soft 404.

# The two self-report quizzes were superseded by the automated scanner.
/audit/                                            /resources/scan/               301
/es/audit/                                         /es/resources/scan/            301
/resources/visibility/                             /resources/scan/               301
/es/resources/visibility/                          /es/resources/scan/            301

